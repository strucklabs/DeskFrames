<Window x:Class="DeskFrames.UI.ManageWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskFrames" Width="680" Height="500" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="#FAFAFA" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Outer" CornerRadius="4" BorderThickness="2" BorderBrush="Transparent" Padding="2">
                            <Border CornerRadius="2" Background="{TemplateBinding Background}" BorderBrush="#40000000" BorderThickness="1"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#9AA0A6"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="selected">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Liste der Rahmen -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Frames" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="AddButton" Content="Add frame…" Click="OnAdd" Margin="0,0,8,0"/>
                <Button x:Name="RemoveButton" Content="Remove" Click="OnRemove"/>
            </StackPanel>
            <Grid>
                <ListBox x:Name="FrameList" SelectionChanged="OnSelectionChanged" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderBrush="#D0D3D8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,4">
                                <Border DockPanel.Dock="Left" Width="44" Height="44" Background="#ECEDEF" CornerRadius="3" Margin="0,0,10,0">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyHint" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                           Margin="16" Foreground="#6B7280" IsHitTestVisible="False"
                           Text="No frames yet. Add a frame to put a picture on your desktop."/>
            </Grid>
        </DockPanel>

        <!-- Einstellungen des gewählten Rahmens -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Details">
                <Border Height="170" Background="#ECEDEF" CornerRadius="4" Padding="12">
                    <Viewbox Stretch="Uniform" StretchDirection="Both">
                        <Border x:Name="PreviewFrame" Background="#3A3C40">
                            <Grid>
                                <TextBlock x:Name="PreviewMissing" Text="Image not found" Foreground="#C8CACE"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24"/>
                                <Image x:Name="PreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>
                    </Viewbox>
                </Border>

                <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="Change image…" Click="OnChangeImage" Margin="10,0,0,0"/>
                    <TextBlock x:Name="FilePath" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#4B5563"/>
                </DockPanel>

                <TextBlock Style="{StaticResource Label}" Text="Border color"/>
                <WrapPanel x:Name="Swatches">
                    <Button Content="Custom…" Click="OnCustomColor" MinWidth="0" Padding="8,2" Height="26" VerticalAlignment="Top"/>
                </WrapPanel>

                <TextBlock Style="{StaticResource Label}" Text="Border width"/>
                <DockPanel>
                    <TextBlock x:Name="WidthText" DockPanel.Dock="Right" Width="64" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider x:Name="WidthSlider" AutomationProperties.Name="Border width" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True"
                            SmallChange="1" LargeChange="4" VerticalAlignment="Center" ValueChanged="OnWidthChanged"/>
                </DockPanel>

                <Button Content="Apply to all frames" HorizontalAlignment="Left" Margin="0,16,0,0" Click="OnApplyToAll"
                        ToolTip="Use this border color and width for every frame"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Fußzeile -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0">
            <CheckBox x:Name="AutostartBox" DockPanel.Dock="Right" Content="Start with Windows" VerticalAlignment="Center"
                      Click="OnAutostartClick"/>
            <TextBlock TextWrapping="Wrap" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,16,0"
                       Text="Hold Ctrl+Shift to move or resize frames on the desktop. Right-click a frame while holding them for more options."/>
        </DockPanel>
    </Grid>
</Window>
