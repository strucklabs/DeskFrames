<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Nur für das Tray-Symbol (NotifyIcon) und die Monitor-Liste -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Erzeugt mit Assets\make-icon.ps1 -->
    <ApplicationIcon>Assets\DeskFrames.ico</ApplicationIcon>
    <AssemblyName>DeskFrames</AssemblyName>
    <RootNamespace>DeskFrames</RootNamespace>
    <StartupObject>DeskFrames.Program</StartupObject>
    <Version>0.1.0</Version>
    <!-- WinForms-Analyzer will DPI-Einstellungen per API; für WPF gehört das ins Manifest -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Testprojekt und Machbarkeitsprobe liegen in Unterordnern und gehören nicht in die EXE -->
    <Compile Remove="tests\**;probe\**" />
    <None Remove="tests\**;probe\**" />
    <EmbeddedResource Remove="tests\**;probe\**" />
    <Page Remove="tests\**;probe\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms-Namespaces kollidieren mit WPF (Application, Color, Point ...) -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dasselbe Symbol für Infobereich und Fenster -->
    <EmbeddedResource Include="Assets\DeskFrames.ico" LogicalName="DeskFrames.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeskFrames.Tests" />
  </ItemGroup>

</Project>
